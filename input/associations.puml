@startuml Associations and Multiplicities Diagram

class Customer {
  +id: int
  +name: string
  +PlaceOrder(o: Order): bool
}
class Order {
  +id: int
  +total: float
  +AddItem(i: Item)
}
class Item {
  +sku: string
  +price: float
}
Customer "1" --> "0..*" Order : places
Order "1" --> "0..*" Item : contains
@enduml
